# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env не попадает в git.

# Секрет для подписи cookie сессии — длинная случайная строка (не меньше 32 символов).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Порт сервера (по умолчанию 3000)
PORT=3000

# Адрес сайта для ссылок в QR-кодах электронных справок.
# Локально — http://localhost:3000; после выкладки — настоящий адрес, например https://dekanat.example.ru
PUBLIC_URL=http://localhost:3000

# ИИ-помощник «Спроси деканат» (GigaChat). Используются только на сервере.
# Без них кабинет работает, а помощник сообщает, что недоступен.
# Ключ авторизации из личного кабинета GigaChat API (developers.sber.ru):
GIGACHAT_AUTH_KEY=
# Тариф: GIGACHAT_API_PERS (физлица), GIGACHAT_API_B2B или GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Необязательно: модель (по умолчанию GigaChat-2-Pro)
# GIGACHAT_MODEL=GigaChat-2-Pro

# Папка для данных, которые пишутся во время работы (база SQLite).
# Локально можно не задавать — будет папка data/ в проекте.
# На Amvera обязательно: DATA_DIR=/data (постоянное хранилище, переживает перезапуски и пересборки).
# DATA_DIR=/data

# Необязательно: полный путь к файлу базы (по умолчанию DATA_DIR/dekanat.db)
# DB_PATH=/data/dekanat.db

# На хостинге с HTTPS поставьте production: сервер доверяет HTTPS-прокси хостинга,
# cookie входа уходит только по HTTPS.
# NODE_ENV=production
