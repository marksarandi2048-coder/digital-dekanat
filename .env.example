# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env не попадает в git.

# Секрет для подписи cookie сессии — длинная случайная строка (не меньше 32 символов).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Порт сервера (по умолчанию 3000)
PORT=3000

# Адрес сайта для ссылок в QR-кодах электронных справок.
# Локально — http://localhost:3000; после выкладки — настоящий адрес, например https://dekanat.example.ru
PUBLIC_URL=http://localhost:3000

# Необязательно: путь к файлу базы (по умолчанию data/dekanat.db)
# DB_PATH=data/dekanat.db

# На боевом сервере с HTTPS поставьте production — cookie будут только по HTTPS
# NODE_ENV=production
